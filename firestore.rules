rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isExpectedAppId(appId) {
      return appId == 'tecnopan-inventory-app';
    }

    function fallbackStaffEmails() {
      return [
        'joe.barrettoburns@gmail.com',
        'sahjin.ribeiro@gmail.com'
      ];
    }

    // Safely extract the email from the auth token
    function getEmail() {
      let token = request.auth.token;
      let hasEmail = token != null && 'email' in token && token.email is string && token.email != '';
      let hasIdentityEmail = token != null && 'firebase' in token && 
                             'identities' in token.firebase && 
                             'email' in token.firebase.identities && 
                             token.firebase.identities.email is list && 
                             token.firebase.identities.email.size() > 0 && 
                             token.firebase.identities.email[0] is string;
                             
      return hasEmail ? token.email.lower() : (hasIdentityEmail ? token.firebase.identities.email[0].lower() : '');
    }

    // Check if the email is in the provided list, accounting for gmail/googlemail aliases
    function isEmailAllowed(email, allowedList) {
      return email in allowedList || 
             (email.matches('.*@gmail\\.com') && email.replace('@gmail\\.com', '@googlemail.com') in allowedList) || 
             (email.matches('.*@googlemail\\.com') && email.replace('@googlemail\\.com', '@gmail.com') in allowedList);
    }

    function isFallbackStaff() {
      let email = getEmail();
      return email != '' && isEmailAllowed(email, fallbackStaffEmails());
    }

    function isAllowlisted() {
      let email = getEmail();
      let docPath = /databases/$(database)/documents/artifacts/tecnopan-inventory-app/config/access_allowlist;
      let allowlistDoc = get(docPath);
      
      return email != '' &&
             allowlistDoc != null &&
             'emails' in allowlistDoc.data && 
             allowlistDoc.data.emails is list &&
             isEmailAllowed(email, allowlistDoc.data.emails);
    }

    // Main access check: user must be signed in, have an email, and be in either list
    function hasAccess(appId) {
      return request.auth != null && 
             isExpectedAppId(appId) && 
             (isFallbackStaff() || isAllowlisted());
    }

    // Any signed-in user may READ the allowlist (the client needs it to evaluate access
    // before it knows whether the user is staff), but only allowlisted/staff accounts may
    // WRITE it. Leaving this writable to any authenticated user would let anyone with a
    // Google account add themselves and gain full access to the app data.
    match /artifacts/{appId}/config/access_allowlist {
      allow read: if request.auth != null && isExpectedAppId(appId);
      allow write: if hasAccess(appId);
    }

    // Inventory count invariant: a sheet may only be CONSUMED (status -> 'Used',
    // stamped with a new usageLogId + usedAt) while it is currently 'On Hand'. This
    // makes a double-claim by two concurrent clients fail at the database instead of
    // silently corrupting counts. The combination of (status->Used) + (new log) +
    // (new usedAt) uniquely identifies a fresh consumption, so it does NOT block
    // legitimate re-writes of already-Used sheets: count-repair pointer fixes change
    // only usageLogId (usedAt unchanged), and a log edit keeps sheets on the same log.
    function isFreshConsumption() {
      let newStatus = request.resource.data.get('status', '');
      let newLog = request.resource.data.get('usageLogId', null);
      let oldLog = resource.data.get('usageLogId', null);
      let newUsedAt = request.resource.data.get('usedAt', null);
      let oldUsedAt = resource.data.get('usedAt', null);
      return newStatus == 'Used' && newLog != oldLog && newUsedAt != oldUsedAt;
    }
    function inventoryUpdateOk() {
      return !isFreshConsumption() || resource.data.get('status', '') == 'On Hand';
    }

    // Protect all actual app data. The recursive match also covers top-level
    // inventory/{id} docs; only those updates carry the consumption guard (matched by
    // path), so backups, usage_logs, materials, supplier_settings, etc. keep the
    // simple access gate.
    match /artifacts/{appId}/public/data/{document=**} {
      allow read: if hasAccess(appId);
      allow create, delete: if hasAccess(appId);
      allow update: if hasAccess(appId) &&
        (!document.matches('inventory/[^/]+') || inventoryUpdateOk());
    }
  }
}